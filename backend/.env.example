# ── Servidor ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Base de datos ─────────────────────────────────────────────
DB_PATH=/data/database.db

# ── JWT ───────────────────────────────────────────────────────
# Genera con: openssl rand -hex 64
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_64_CARACTERES
JWT_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=https://cyclocoach-pro.fly.dev
APP_URL=https://cyclocoach-pro.fly.dev

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ── IA: Claude (Anthropic) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── IA: Google Gemini ─────────────────────────────────────────
GOOGLE_API_KEY=AIzaSy...

# ── IA: OpenAI (opcional) ─────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Strava OAuth (opcional) ──────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Email(s) de administrador, separados por comas: ven el panel /admin.html y pueden responder feedback
ADMIN_EMAIL=

# Límite de atletas que Strava permite a la app (panel admin → Plazas de Strava)
STRAVA_ATHLETE_CAPACITY=10
# Cuentas cuya plaza de Strava nunca se puede liberar (por defecto: jbautistaalvarez@hotmail.com)
STRAVA_RESERVED_EMAILS=jbautistaalvarez@hotmail.com

# Email: Brevo (recomendado, 300/día gratis). Si no está, se usa SENDGRID_API_KEY
BREVO_API_KEY=
# Remitente (debe estar verificado en Brevo)
MAIL_FROM_EMAIL=info@velomind.org
# true = el login exige email verificado. Déjalo vacío si el email no funciona
REQUIRE_EMAIL_VERIFICATION=
