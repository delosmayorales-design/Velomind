{
  "version": 2,
  "builds": [
    {
      "src": "cyclocoach/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/cyclocoach/login.html" },
    { "src": "^/index\\.html$", "dest": "/cyclocoach/login.html" },
    { "src": "^/support$", "dest": "/cyclocoach/soporte.html" },
    { "src": "^/support\\.html$", "dest": "/cyclocoach/soporte.html" },
    { "src": "/app/(.*)", "dest": "/cyclocoach/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/cyclocoach/login.html" }
  ]
}
